<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This project is NOT part of the Unity project. It exists solely so that the
    UnityEngine-free gameplay logic under Assets/_Project/Scripts/{Core,Configuration,Gameplay}
    (and the matching NUnit tests under Assets/Tests/EditMode) can be compiled and actually
    executed with `dotnet test` in an environment without the Unity Editor.

    Every <Compile Include> below links (not copies) the exact same .cs files that ship
    inside the Unity project, so there is a single source of truth. Only files that use
    UnityEngine (ScriptableObject/MonoBehaviour adapters) are excluded here — those can only
    be verified inside the Unity Editor, see README_M1.md.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace></RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

