# ===== Unity generated =====
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/

# Never commit generated meta cache; .meta files for tracked assets ARE committed.
*.tmp

# Asset meta data should only be ignored when the corresponding asset is also ignored
!*.meta

# Autogenerated VS/Rider/MD solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Keystores — NEVER commit signing keys or credentials
*.keystore
*.jks
keystore.properties
android_keystore*
*.p12

# Local secrets / CI credentials
*.env
secrets.json

# OS / editor
.DS_Store
.vs/
.idea/
*.swp

# ===== dotnet-tests (standalone verification project under tools/) =====
# Ignores build output, then re-allows the hand-written .csproj that the generic
# "*.csproj" rule above (targeting Unity's auto-generated per-script IDE project
# files) would otherwise also hide. Negations must come last to win.
tools/dotnet-tests/**/bin/
tools/dotnet-tests/**/obj/
tools/dotnet-tests/**/TestResults/
!tools/dotnet-tests/**/*.csproj
!tools/dotnet-tests/**/*.cs
